<?xml version="1.0" ?>
<FuzzySystem>
  <InputVariables>
    <InputVariable name="temperature" min="0" max="40" unit="°C">
      <FuzzySet name="COLD" type="triangular" a="0" b="10" c="20"/>
      <FuzzySet name="WARM" type="triangular" a="15" b="25" c="35"/>
      <FuzzySet name="HOT" type="triangular" a="30" b="40" c="40"/>
    </InputVariable>
  </InputVariables>
  <OutputVariables>
    <OutputVariable name="fan_speed" min="0" max="100" unit="rpm" nb_points="200" defuzzification="CoG" aggregation="Max">
      <FuzzySet name="SLOW" type="triangular" a="0" b="20" c="40"/>
      <FuzzySet name="MEDIUM" type="triangular" a="30" b="50" c="70"/>
      <FuzzySet name="FAST" type="triangular" a="60" b="80" c="100"/>
    </OutputVariable>
  </OutputVariables>
  <Rules>
    <Rule id="1" description="if temperature is cold then fan is slow">
      <Premise operator="AND">
        <Clause variable="temperature" set="COLD"/>
      </Premise>
      <Conclusion variable="fan_speed" set="SLOW"/>
    </Rule>
    <Rule id="2" description="if temperature is warm then fan is medium">
      <Premise operator="AND">
        <Clause variable="temperature" set="WARM"/>
      </Premise>
      <Conclusion variable="fan_speed" set="MEDIUM"/>
    </Rule>
    <Rule id="3" description="if temperature is hot then fan is fast">
      <Premise operator="AND">
        <Clause variable="temperature" set="HOT"/>
      </Premise>
      <Conclusion variable="fan_speed" set="FAST"/>
    </Rule>
  </Rules>
</FuzzySystem>
